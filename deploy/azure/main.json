{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {"type": "string", "defaultValue": "southeastasia"},
    "appName": {"type": "string", "minLength": 3, "maxLength": 60},
    "planName": {"type": "string"},
    "vaultName": {"type": "string", "minLength": 3, "maxLength": 24},
    "supabaseUrl": {"type": "string"},
    "firebaseProjectId": {"type": "string"}
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[parameters('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "tags": {"project": "tabby", "managedBy": "AZ-001"},
      "sku": {"name": "B1", "tier": "Basic", "capacity": 1},
      "properties": {"reserved": true}
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('vaultName')]",
      "location": "[parameters('location')]",
      "tags": {"project": "tabby", "managedBy": "AZ-001"},
      "properties": {
        "tenantId": "[subscription().tenantId]",
        "sku": {"family": "A", "name": "standard"},
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "enablePurgeProtection": true,
        "publicNetworkAccess": "Enabled",
        "accessPolicies": []
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {"type": "SystemAssigned"},
      "tags": {"project": "tabby", "managedBy": "AZ-001"},
      "dependsOn": ["[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]", "[resourceId('Microsoft.KeyVault/vaults', parameters('vaultName'))]"],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('planName'))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "siteConfig": {
          "linuxFxVersion": "NODE|24-lts",
          "appCommandLine": "node backend/server.mjs",
          "use32BitWorkerProcess": false,
          "alwaysOn": true,
          "minTlsVersion": "1.2",
          "scmMinTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "http20Enabled": true,
          "healthCheckPath": "/healthz",
          "appSettings": [
            {"name": "NODE_ENV", "value": "production"},
            {"name": "SCM_DO_BUILD_DURING_DEPLOYMENT", "value": "false"},
            {"name": "WORKERS_ENABLED", "value": "false"},
            {"name": "SUPABASE_URL", "value": "[parameters('supabaseUrl')]"},
            {"name": "FIREBASE_PROJECT_ID", "value": "[parameters('firebaseProjectId')]"},
            {"name": "SUPABASE_SERVICE_ROLE_KEY", "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('vaultName'), ';SecretName=supabase-service-role-key)')]"},
            {"name": "PRIVACY_REVIEW_SECRET", "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('vaultName'), ';SecretName=privacy-review-secret)')]"},
            {"name": "PUSH_WORKER_SECRET", "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('vaultName'), ';SecretName=push-worker-secret)')]"},
            {"name": "RECURRENCE_WORKER_SECRET", "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('vaultName'), ';SecretName=recurrence-worker-secret)')]"},
            {"name": "FIREBASE_SERVICE_ACCOUNT_JSON", "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('vaultName'), ';SecretName=firebase-service-account-json)')]"}
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2023-12-01",
      "name": "[concat(parameters('appName'), '/scm')]",
      "dependsOn": ["[resourceId('Microsoft.Web/sites', parameters('appName'))]"],
      "properties": {"allow": false}
    },
    {
      "type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
      "apiVersion": "2023-12-01",
      "name": "[concat(parameters('appName'), '/ftp')]",
      "dependsOn": ["[resourceId('Microsoft.Web/sites', parameters('appName'))]"],
      "properties": {"allow": false}
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('vaultName')), parameters('appName'), 'secret-reader')]",
      "scope": "[concat('Microsoft.KeyVault/vaults/', parameters('vaultName'))]",
      "dependsOn": ["[resourceId('Microsoft.KeyVault/vaults', parameters('vaultName'))]", "[resourceId('Microsoft.Web/sites', parameters('appName'))]"],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "endpoint": {"type": "string", "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName)]"},
    "vaultName": {"type": "string", "value": "[parameters('vaultName')]"}
  }
}
