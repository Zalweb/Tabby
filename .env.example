# ============================================================================
# Tabby Mobile Client — Supabase Configuration Template
# ============================================================================
# Duplicate this file as '.env' in your local development environment.
# Obtain these credentials from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon public key)
# ============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Client Key (safe for mobile client distribution)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Storage Bucket Name (default: payment-proofs)
SUPABASE_STORAGE_BUCKET=payment-proofs
