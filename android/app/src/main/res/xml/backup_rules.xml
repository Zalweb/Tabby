<?xml version="1.0" encoding="utf-8"?>
<!-- Device-bound keys cannot decrypt restored secure storage. Keep all
     account data and queued financial operations on the originating device. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
